@page
@model LifeTag.Pages.Forms.addUserProfileModel
@{
	ViewData["Title"] = "User Profile";
}

<div class="container mt-4">
    <h2 class="mb-3 text-center">Life Tag – Medical Information</h2>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Full Name</label>
            <input asp-for="User.FullName" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Date of Birth</label>
            <input asp-for="User.DateOfBirth" type="date" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label">Blood Type</label>
            <select asp-for="User.BloodType" class="form-select">
                <option value="">Select</option>
                <option>A+</option><option>A-</option>
                <option>B+</option><option>B-</option>
                <option>AB+</option><option>AB-</option>
                <option>O+</option><option>O-</option>
            </select>
        </div>

        <button class="btn btn-dark w-100">Save</button>
    </form>
</div>